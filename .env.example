# Docker Compose configuration. Native development uses backend/.env and frontend/.env.local.
# Run php docker/setup-infrastructure.php to fill the missing secrets below.
APP_KEY=
DB_DATABASE=education_management
DB_USERNAME=ems
# Setup generates this password for a new installation; preserve it after initialization.
DB_PASSWORD=
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Only false for the local HTTP setup. Use true when serving over HTTPS.
COOKIE_SECURE=false

# Generated by php docker/setup-infrastructure.php. Never commit the real .env.
REDIS_PASSWORD=
JWT_SECRET=
JWT_ISSUER=ems-api
JWT_AUDIENCE=ems-api
JWT_TTL_MINUTES=15
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_BUCKET=ems-private
GARAGE_PORT=13900
DOCUMENT_STORAGE_DISK=garage
